{
    "version": "2.0.0",
    "tasks": [

        // ── CLEAN ─────────────────────────────────────────────────────────────
        {
            "label": "Finance - Clean Build",
            "type": "shell",
            "command": "rm -rf build",
            "problemMatcher": [],
            "icon": {
                "id": "trash",
                "color": "terminal.ansiRed"
            }
        },
        {
            "label": "Finance - Clean CMake Cache",
            "type": "shell",
            "command": "rm -rf build/build_cli/CMakeCache.txt build/build_cli/CMakeFiles build/build_cli/Makefile build/build_cli/cmake_install.cmake build/build_qt/CMakeCache.txt build/build_qt/CMakeFiles build/build_qt/Makefile build/build_qt/cmake_install.cmake",
            "problemMatcher": [],
            "icon": {
                "id": "trash",
                "color": "terminal.ansiRed"
            }
        },
        {
            "label": "Finance - Clean Runtime Data",
            "type": "shell",
            "command": "rm -f data/finance.db && rm -f data/backups/* && rm -f reports/*",
            "problemMatcher": [],
            "icon": {
                "id": "database",
                "color": "terminal.ansiRed"
            }
        },

        // ── CMAKE CONFIGURATION ───────────────────────────────────────────────
        {
            "label": "Finance - Configure Console",
            "type": "shell",
            "command": "cmake -S . -B build/build_cli -DBUILD_QT5_GUI=OFF -DCMAKE_BUILD_TYPE=Release",
            "problemMatcher": [],
            "icon": {
                "id": "terminal",
                "color": "terminal.ansiBlue"
            }
        },
        {
            "label": "Finance - Configure Qt5",
            "type": "shell",
            "command": "cmake -S . -B build/build_qt -DBUILD_QT5_GUI=ON -DCMAKE_BUILD_TYPE=Release",
            "problemMatcher": [],
            "icon": {
                "id": "window",
                "color": "terminal.ansiCyan"
            }
        },
        {
            "label": "Finance - Configure All",
            "type": "shell",
            "command": "cmake -S . -B build/build_cli -DBUILD_QT5_GUI=OFF -DCMAKE_BUILD_TYPE=Release && cmake -S . -B build/build_qt -DBUILD_QT5_GUI=ON -DCMAKE_BUILD_TYPE=Release",
            "problemMatcher": [],
            "icon": {
                "id": "gear",
                "color": "terminal.ansiBlue"
            }
        },

        // ── BUILD ─────────────────────────────────────────────────────────────
        {
            "label": "Finance - Build Console",
            "type": "shell",
            "command": "cmake --build build/build_cli --parallel",
            "dependsOn": [
                "Finance - Configure Console"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "icon": {
                "id": "terminal",
                "color": "terminal.ansiGreen"
            }
        },
        {
            "label": "Finance - Build Qt5 GUI",
            "type": "shell",
            "command": "cmake --build build/build_qt --parallel",
            "dependsOn": [
                "Finance - Configure Qt5"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [
                "$gcc"
            ],
            "icon": {
                "id": "window",
                "color": "terminal.ansiCyan"
            }
        },
        {
            "label": "Finance - Build All",
            "type": "shell",
            "command": "cmake --build build/build_cli --parallel && cmake --build build/build_qt --parallel",
            "dependsOn": [
                "Finance - Configure All"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "icon": {
                "id": "rocket",
                "color": "terminal.ansiGreen"
            }
        },
        {
            "label": "Finance - Rebuild Console",
            "type": "shell",
            "command": "cmake --build build/build_cli --clean-first --parallel",
            "dependsOn": [
                "Finance - Configure Console"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [
                "$gcc"
            ],
            "icon": {
                "id": "sync",
                "color": "terminal.ansiYellow"
            }
        },
        {
            "label": "Finance - Rebuild Qt5 GUI",
            "type": "shell",
            "command": "cmake --build build/build_qt --clean-first --parallel",
            "dependsOn": [
                "Finance - Configure Qt5"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [
                "$gcc"
            ],
            "icon": {
                "id": "sync",
                "color": "terminal.ansiYellow"
            }
        },
        {
            "label": "Finance - Rebuild All",
            "type": "shell",
            "command": "cmake --build build/build_cli --clean-first --parallel && cmake --build build/build_qt --clean-first --parallel",
            "dependsOn": [
                "Finance - Configure All"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [
                "$gcc"
            ],
            "icon": {
                "id": "sync",
                "color": "terminal.ansiYellow"
            }
        },

        // ── DIST / PACKAGE ────────────────────────────────────────────────────
        {
            "label": "Finance - Copy Console to Dist",
            "type": "shell",
            "command": "mkdir -p dist/dist_cli && cp build/build_cli/personal_finance_tracker dist/dist_cli/",
            "dependsOn": [
                "Finance - Build Console"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "icon": {
                "id": "package",
                "color": "terminal.ansiGreen"
            }
        },
        {
            "label": "Finance - Copy Qt5 to Dist",
            "type": "shell",
            "command": "mkdir -p dist/dist_qt && cp build/build_qt/personal_finance_tracker_qt dist/dist_qt/",
            "dependsOn": [
                "Finance - Build Qt5 GUI"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "icon": {
                "id": "package",
                "color": "terminal.ansiCyan"
            }
        },
        {
            "label": "Finance - Copy All to Dist",
            "type": "shell",
            "command": "mkdir -p dist/dist_cli dist/dist_qt && cp build/build_cli/personal_finance_tracker dist/dist_cli/ && cp build/build_qt/personal_finance_tracker_qt dist/dist_qt/",
            "dependsOn": [
                "Finance - Build All"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "icon": {
                "id": "package",
                "color": "terminal.ansiGreen"
            }
        },

        // ── TESTS ─────────────────────────────────────────────────────────────
        {
            "label": "Finance - Build Tests",
            "type": "shell",
            "command": "cmake --build build/build_cli --target finance_tests --parallel",
            "dependsOn": [
                "Finance - Configure Console"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [
                "$gcc"
            ],
            "icon": {
                "id": "beaker",
                "color": "terminal.ansiYellow"
            }
        },
        {
            "label": "Finance - Run Console Tests",
            "type": "shell",
            "command": "ctest --test-dir build/build_cli --output-on-failure",
            "dependsOn": [
                "Finance - Build Tests"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "icon": {
                "id": "beaker",
                "color": "terminal.ansiGreen"
            }
        },
        {
            "label": "Finance - Run Qt5 Tests",
            "type": "shell",
            "command": "ctest --test-dir build/build_qt --output-on-failure",
            "dependsOn": [
                "Finance - Build Qt5 GUI"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "icon": {
                "id": "beaker",
                "color": "terminal.ansiCyan"
            }
        },
        {
            "label": "Finance - Run All Tests",
            "type": "shell",
            "command": "ctest --test-dir build/build_cli --output-on-failure && ctest --test-dir build/build_qt --output-on-failure",
            "dependsOn": [
                "Finance - Build All"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "icon": {
                "id": "beaker",
                "color": "terminal.ansiGreen"
            }
        },

        // ── RUN ───────────────────────────────────────────────────────────────
        {
            "label": "Finance - Run Console",
            "type": "shell",
            "command": "./dist/dist_cli/personal_finance_tracker data/finance.db",
            "dependsOn": [
                "Finance - Copy Console to Dist"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": true
            },
            "icon": {
                "id": "terminal",
                "color": "terminal.ansiGreen"
            }
        },
        {
            "label": "Finance - Run Qt5 GUI",
            "type": "shell",
            "command": "./dist/dist_qt/personal_finance_tracker_qt data/finance.db",
            "dependsOn": [
                "Finance - Copy Qt5 to Dist"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "icon": {
                "id": "window",
                "color": "terminal.ansiCyan"
            }
        },

        // ── MAKEFILE ──────────────────────────────────────────────────────────
        {
            "label": "Finance - Make Build",
            "type": "shell",
            "command": "make -j$(nproc)",
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "icon": {
                "id": "hammer",
                "color": "terminal.ansiGreen"
            }
        },
        {
            "label": "Finance - Make Build Console",
            "type": "shell",
            "command": "make build-cli",
            "problemMatcher": [
                "$gcc"
            ],
            "icon": {
                "id": "terminal",
                "color": "terminal.ansiGreen"
            }
        },
        {
            "label": "Finance - Make Build Qt5",
            "type": "shell",
            "command": "make build-qt",
            "problemMatcher": [
                "$gcc"
            ],
            "icon": {
                "id": "window",
                "color": "terminal.ansiCyan"
            }
        },
        {
            "label": "Finance - Make Test",
            "type": "shell",
            "command": "make test",
            "problemMatcher": [
                "$gcc"
            ],
            "icon": {
                "id": "beaker",
                "color": "terminal.ansiGreen"
            }
        },
        {
            "label": "Finance - Make Run Console",
            "type": "shell",
            "command": "make run",
            "dependsOn": [
                "Finance - Make Build Console"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "focus": true
            },
            "icon": {
                "id": "terminal",
                "color": "terminal.ansiGreen"
            }
        },
        {
            "label": "Finance - Make Run Qt5",
            "type": "shell",
            "command": "make run-qt",
            "dependsOn": [
                "Finance - Make Build Qt5"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always"
            },
            "icon": {
                "id": "window",
                "color": "terminal.ansiCyan"
            }
        },
        {
            "label": "Finance - Make Clean",
            "type": "shell",
            "command": "make clean",
            "problemMatcher": [],
            "icon": {
                "id": "trash",
                "color": "terminal.ansiRed"
            }
        },

        // ── DATABASE / DATA ───────────────────────────────────────────────────
        {
            "label": "Finance - Open SQLite Database",
            "type": "shell",
            "command": "sqlite3 data/finance.db",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "icon": {
                "id": "database",
                "color": "terminal.ansiYellow"
            }
        },
        {
            "label": "Finance - Show Database Tables",
            "type": "shell",
            "command": "sqlite3 data/finance.db '.tables'",
            "problemMatcher": [],
            "icon": {
                "id": "database",
                "color": "terminal.ansiBlue"
            }
        },
        {
            "label": "Finance - Backup Database",
            "type": "shell",
            "command": "mkdir -p data/backups && sqlite3 data/finance.db \".backup 'data/backups/finance-$(date +%Y%m%d-%H%M%S).db'\"",
            "problemMatcher": [],
            "icon": {
                "id": "save",
                "color": "terminal.ansiCyan"
            }
        },

        // ── REPORTS ───────────────────────────────────────────────────────────
        {
            "label": "Finance - Generate Monthly Chart",
            "type": "shell",
            "command": "./dist/dist_cli/personal_finance_tracker data/finance.db",
            "dependsOn": [
                "Finance - Copy Console to Dist"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "icon": {
                "id": "graph",
                "color": "terminal.ansiBlue"
            }
        },

        // ── WSL SETUP ─────────────────────────────────────────────────────────
        {
            "label": "Finance - Install WSL Dependencies",
            "type": "shell",
            "command": "sudo apt update && sudo apt install -y build-essential cmake ninja-build libsqlite3-dev",
            "problemMatcher": [],
            "icon": {
                "id": "package",
                "color": "terminal.ansiCyan"
            }
        },
        {
            "label": "Finance - Install Qt5 WSL Dependencies",
            "type": "shell",
            "command": "sudo apt update && sudo apt install -y build-essential cmake ninja-build qtbase5-dev qtbase5-dev-tools libqt5charts5-dev libsqlite3-dev",
            "problemMatcher": [],
            "icon": {
                "id": "package",
                "color": "terminal.ansiCyan"
            }
        },
        {
            "label": "Finance - Verify Qt5",
            "type": "shell",
            "command": "qmake --version && pkg-config --modversion Qt5Widgets && pkg-config --modversion Qt5Charts",
            "problemMatcher": [],
            "icon": {
                "id": "check",
                "color": "terminal.ansiGreen"
            }
        },

        // ── FORMAT ────────────────────────────────────────────────────────────
        {
            "label": "Finance - Format Current File",
            "type": "shell",
            "command": "clang-format -i ${file}",
            "problemMatcher": [],
            "icon": {
                "id": "symbol-color",
                "color": "terminal.ansiGreen"
            }
        },
        {
            "label": "Finance - Format C++ Sources",
            "type": "shell",
            "command": "find include src tests -type f \\( -name '*.cpp' -o -name '*.hpp' -o -name '*.h' \\) -print0 | xargs -0 clang-format -i",
            "problemMatcher": [],
            "icon": {
                "id": "symbol-color",
                "color": "terminal.ansiGreen"
            }
        },

        // ── FULL DEVELOPMENT WORKFLOWS ────────────────────────────────────────
        {
            "label": "Finance - Full Console Check",
            "type": "shell",
            "command": "make build-cli && ctest --test-dir build/build_cli --output-on-failure",
            "problemMatcher": [
                "$gcc"
            ],
            "group": "test",
            "icon": {
                "id": "verified",
                "color": "terminal.ansiGreen"
            }
        },
        {
            "label": "Finance - Full Qt5 Check",
            "type": "shell",
            "command": "make build-qt && ctest --test-dir build/build_qt --output-on-failure",
            "problemMatcher": [
                "$gcc"
            ],
            "group": "test",
            "icon": {
                "id": "verified",
                "color": "terminal.ansiCyan"
            }
        },
        {
            "label": "Finance - Full Check",
            "type": "shell",
            "command": "make build && make test",
            "problemMatcher": [
                "$gcc"
            ],
            "group": "test",
            "icon": {
                "id": "verified",
                "color": "terminal.ansiGreen"
            }
        },
        {
            "label": "Finance - Clean Rebuild and Test",
            "type": "shell",
            "command": "make clean && make build && make test",
            "problemMatcher": [
                "$gcc"
            ],
            "group": "test",
            "icon": {
                "id": "sync",
                "color": "terminal.ansiGreen"
            }
        }
    ]
}
